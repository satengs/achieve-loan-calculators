{
  "id": "student-loan",
  "locale": "en-US",
  "currency": "USD",
  "defaults": {
    "balance": 30000,
    "apr": 6.5,
    "termYears": 10,
    "deferMonths": 0,
    "extraMonthly": 0
  },
  "validation": {
    "balance": {
      "min": 100,
      "max": 10000000,
      "label": "Balance",
      "allowZero": false
    },
    "apr": {
      "min": 0,
      "max": 30,
      "label": "Rate",
      "allowZero": true
    },
    "termYears": {
      "min": 1,
      "max": 30,
      "label": "Term",
      "allowZero": false
    },
    "deferMonths": {
      "min": 0,
      "max": 120,
      "label": "Deferment months",
      "allowZero": true
    },
    "extraMonthly": {
      "min": 0,
      "max": 1000000,
      "label": "Extra payment",
      "allowZero": true
    }
  },
  "features": {
    "rateKey": null
  },
  "cta": {
    "enabled": true,
    "preventDefault": true
  }
}
