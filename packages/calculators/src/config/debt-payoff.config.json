{
  "id": "debt-payoff",
  "locale": "en-US",
  "currency": "USD",
  "defaults": {
    "debtAmount": 20000,
    "apr": 22.77,
    "planPayment": 700,
    "minPrincipalPct": 1,
    "minFloor": 35,
    "programCostPct": 90,
    "programMonths": 48,
    "waitGrowthPct": 10
  },
  "validation": {
    "debtAmount": {
      "min": 1000,
      "max": 1000000,
      "label": "Debt amount",
