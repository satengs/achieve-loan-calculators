    "planPayment": {
      "min": 1,
      "max": 1000000,
      "label": "Plan payment",
      "allowZero": false
    },
    "minPrincipalPct": {
      "min": 0.1,
      "max": 100,
      "label": "Principal %",
      "allowZero": false
    },
    "minFloor": {
      "min": 0,
      "max": 10000,
      "label": "Minimum floor",
      "allowZero": true
    },
    "programCostPct": {
      "min": 0,
      "max": 200,
      "label": "Program cost %",
      "allowZero": true
    },
    "programMonths": {
      "min": 1,
      "max": 120,
      "label": "Program length",
      "allowZero": false
    },
    "waitGrowthPct": {
      "min": 0,
      "max": 100,
      "label": "Growth %",
      "allowZero": true
    }
