    "newRate": {
      "min": 0,
      "max": 30,
      "label": "New rate",
      "allowZero": true
    },
    "newTermYears": {
      "min": 1,
      "max": 40,
      "label": "New term",
      "allowZero": false
    },
    "closingCosts": {
      "min": 0,
      "max": 1000000,
      "label": "Closing costs",
      "allowZero": true
