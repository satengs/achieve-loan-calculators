{
  "id": "retirement",
  "locale": "en-US",
  "currency": "USD",
  "defaults": {
    "startAge": 67,
    "savings": 500000,
    "monthlyWithdrawal": 2500,
    "annualReturn": 5,
    "raiseWithInflation": 1
  },
  "validation": {
    "startAge": {
      "min": 40,
      "max": 90,
      "label": "Start age",
      "allowZero": false
    },
    "savings": {
      "min": 0,
      "max": 1000000000,
      "label": "Retirement savings",
      "allowZero": true
    },
    "monthlyWithdrawal": {
      "min": 0,
      "max": 1000000,
      "label": "Monthly withdrawal",
      "allowZero": true
    },
    "annualReturn": {
      "min": 0,
      "max": 20,
      "label": "Return",
      "allowZero": true
    }
  },
  "features": {
    "inflationKey": "inflationYoY",
    "fallbackInflationPct": 3,
    "tipWarnAge": 90,
    "tipTargetAge": 95,
    "maxAge": 120,
    "sliders": {
      "startAge": { "min": 40, "max": 90, "step": 1 },
      "savings": { "min": 0, "max": 2000000, "step": 5000 },
      "monthlyWithdrawal": { "min": 0, "max": 20000, "step": 50 },
      "annualReturn": { "min": 0, "max": 12, "step": 0.25 }
    }
  },
  "cta": {
    "enabled": true,
    "preventDefault": true
  }
}
